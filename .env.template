# Copy to .env (`task init` does this), then paste your licence into VAULT_LICENSE.
# The only secret this file holds is VAULT_LICENSE; all lab credentials live
# inside the VM.

# Multipass VM name
export VM_NAME=tpm-lab

# Device enrolled in Part 6, and the domain its certificate's CN is under
export DEVICE_NAME=node01
export DOMAIN=devices.lab.local

# Pausing between demo parts. 1 (the default) stops after each part of
# `task demo` and waits for a keypress; 0 runs it straight through, which is
# what CI and a quick smoke test want. Per-run: `PAUSE=0 task demo`.
export PAUSE=1

# Vault Enterprise. The VM installs this vault-enterprise apt package version
# and holds it.
export VAULT_VERSION=2.2.0+ent-1

# Vault Enterprise licence TEXT (not a path) — required. Paste the single line
# from your .hclic file. This is the only secret .env holds: it is gitignored,
# and `task provision` hands it to the VM as a root-only systemd EnvironmentFile.
export VAULT_LICENSE=

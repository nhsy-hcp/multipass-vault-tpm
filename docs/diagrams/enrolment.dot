// Vault TPM auth lab — enrolment and login trust flow.
// Render: dot -Tpng -Gdpi=144 -o enrolment.png enrolment.dot
// or: task docs:diagram

digraph enrolment {
  rankdir=TB;
  bgcolor="white";
  compound=true;
  splines=spline;
  nodesep=0.55;
  ranksep=0.70;
  pad=0.35;
  fontname="Helvetica";
  fontsize=12;
  fontcolor="#1a202c";
  labelloc="t";
  label="Enrolment and login — the endorsement key is the credential,\nand the device never holds a Vault token to enrol";

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#4a5568",
    fillcolor="#f7fafc",
    fontcolor="#1a202c",
    penwidth=1.1,
    margin="0.26,0.16"
  ];

  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#4a5568",
    fontcolor="#2d3748",
    penwidth=1.0,
    arrowsize=0.7
  ];

  // ------------------------------------------------------- 1. the endorsement key
  s1 [
    label="1.  vault tpm ek\nthe endorsement key: created from a seed\nburned in at manufacture, never leaves the TPM",
    fillcolor="#dcedd9",
    color="#5f8a57"
  ];

  ekpub [
    label="ek.pub + tpm_id\nthe public half, and\nsha256(EK public key)\n— public, not a secret",
    shape=note,
    style="filled",
    fillcolor="#f3f8f2",
    color="#5f8a57",
    fontsize=10
  ];

  // ---------------------------------------- 2. orchestrator registers the device
  subgraph cluster_orchestrator {
    label="Orchestrator  —  provisioning system, scoped token (not root)";
    labeljust="l";
    fontsize=12;
    fontcolor="#1a202c";
    margin=16;
    style="rounded,filled";
    fillcolor="#eef2f7";
    color="#8fa0b5";
    penwidth=1.2;

    s2 [
      label="2.  vault write identity/tpm  name=node01  tpm_ek_public_key=@ek.pub\nvault write identity/tpmgroup/name/devices  member_tpm_ids=…\nenrol-orchestrator token — register an EK, admit it to one group,\nnothing else: it cannot touch the auth role or read a secret",
      fillcolor="#ece0f2",
      color="#7d5b92"
    ];
  }

  // --------------------------------------------- 3-5. device attests, no token
  subgraph cluster_device {
    label="Device  —  no Vault token, ever";
    labeljust="l";
    fontsize=12;
    fontcolor="#1a202c";
    margin=16;
    style="rounded,filled";
    fillcolor="#fdf7ec";
    color="#d9b678";
    penwidth=1.2;

    s3 [
      label="3.  gentpmcert/begin\nEK public key + a fresh attestation key (AK)\nVault: is this EK registered? does the role trust it?",
      fillcolor="#ece0f2",
      color="#7d5b92"
    ];

    s4 [
      label="4.  TPM2_ActivateCredential\nVault's challenge is encrypted to the EK and bound to the AK;\nonly a TPM holding both can decrypt it",
      fillcolor="#dcedd9",
      color="#5f8a57"
    ];

    s5 [
      label="5.  gentpmcert/finish\ndecrypted challenge + CSR for a new application key\n+ the AK's certification that the key was made in this TPM",
      fillcolor="#ece0f2",
      color="#7d5b92"
    ];

    blobs [
      label="on disk: app.blob, ak.blob\nJSON handles: public area +\nprivate area sealed to this TPM\n— not usable private keys",
      shape=note,
      style="filled",
      fillcolor="#f3f8f2",
      color="#5f8a57",
      fontsize=10
    ];

    s3 -> s4 [label="encrypted\nchallenge", color="#7d5b92", fontcolor="#5b3f6c"];
    s4 -> s5 [label="secret", color="#5f8a57", fontcolor="#3f5f39"];
    s5 -> blobs [style=dotted, color="#5f8a57"];
  }

  // -------------------------------------------------------- 6. Vault issues
  s6 [
    label="6.  the mount's internal CA issues client.crt\nCN=node01.devices.lab.local\nSAN: tpm_id = sha256-…, role = devices",
    fillcolor="#ece0f2",
    color="#7d5b92"
  ];

  // ---------------------------------------------------------- 7. handshake
  s7 [
    label="7.  vault login -method=tpm\nmTLS handshake signed inside the TPM with the application key\nthe private key never crosses the TPM boundary",
    fillcolor="#fdf0da",
    color="#b5883f"
  ];

  // --------------------------------------------------------- 8. validation
  chk1 [
    label="8a.  issued by this\nmount's own CA?",
    shape=diamond,
    style="filled",
    fillcolor="#ece0f2",
    color="#7d5b92",
    fontsize=10,
    margin="0.05,0.02"
  ];

  chk2 [
    label="8b.  TPM ID in the SAN\ntrusted by the role?",
    shape=diamond,
    style="filled",
    fillcolor="#ece0f2",
    color="#7d5b92",
    fontsize=10,
    margin="0.05,0.02"
  ];

  deny [
    label="login refused\nno token issued\n(Parts 8.3 – 8.4)",
    style="rounded,filled,dashed",
    fillcolor="#f8ecec",
    color="#a35b5b",
    fontcolor="#6d3535"
  ];

  // ------------------------------------------------------------- 9. token
  s9 [
    label="9.  token issued\npolicies: default, device-read\nttl 15m / max 1h — metadata: tpm_id, role, CN",
    fillcolor="#ece0f2",
    color="#7d5b92"
  ];

  // ------------------------------------------------------------- 10. usage
  s10read [
    label="10a.  vault kv get\nsecret/devices/node01\n→ succeeds",
    fillcolor="#dcedd9",
    color="#5f8a57"
  ];

  s10write [
    label="10b.  vault kv put\nsecret/devices/node01\n→ permission denied",
    style="rounded,filled,dashed",
    fillcolor="#f8ecec",
    color="#a35b5b",
    fontcolor="#6d3535"
  ];

  // ----------------------------------------------------------------- flow
  s1 -> ekpub [style=dotted, color="#5f8a57"];
  s1 -> s2 [
    lhead=cluster_orchestrator,
    label="   the EK public key travels\n   — the only thing that does;\n   it is public",
    minlen=2,
    color="#5f8a57",
    fontcolor="#3f5f39"
  ];
  s2 -> s3 [
    ltail=cluster_orchestrator, lhead=cluster_device,
    label="   Vault now knows this TPM.\n   Nothing is delivered to the device:\n   an unregistered EK is refused at step 3 (Part 8.2)",
    minlen=2,
    style=dashed,
    color="#7d5b92",
    fontcolor="#5b3f6c"
  ];

  s5 -> s6 [label="attestation verified"];
  s6 -> s7 [label="client.crt"];
  s7 -> chk1 [label="auth/tpm/login\nvalidates"];
  chk1 -> chk2 [label="yes"];
  chk2 -> s9   [label="yes"];
  chk1 -> deny [label="no", color="#a35b5b", fontcolor="#6d3535", style=dashed];
  chk2 -> deny [label="no", color="#a35b5b", fontcolor="#6d3535", style=dashed];
  s9 -> s10read;
  s9 -> s10write [style=dashed, color="#a35b5b"];

  { rank=same; ekpub; s1; }
  { rank=same; chk2; deny; }
  { rank=same; s10read; s10write; }
}

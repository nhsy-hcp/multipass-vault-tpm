// Vault TPM auth lab — component topology.
// Render: dot -Tpng -Gdpi=144 -o topology.png topology.dot
// or: task docs:diagram

digraph topology {
  rankdir=LR;
  bgcolor="white";
  compound=true;
  splines=spline;
  nodesep=0.55;
  ranksep=0.70;
  fontname="Helvetica";
  fontsize=12;
  fontcolor="#1a202c";
  pad=0.35;

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    color="#4a5568",
    fillcolor="#f7fafc",
    fontcolor="#1a202c",
    penwidth=1.1,
    margin="0.18,0.10"
  ];

  edge [
    fontname="Helvetica",
    fontsize=10,
    color="#4a5568",
    fontcolor="#2d3748",
    penwidth=1.0,
    arrowsize=0.7
  ];

  // ---------------------------------------------------------------- macOS host
  subgraph cluster_host {
    label="macOS host";
    labeljust="l";
    fontsize=12;
    fontcolor="#1a202c";
    margin=16;
    style="rounded,filled";
    fillcolor="#eef2f7";
    color="#8fa0b5";
    penwidth=1.2;

    term  [label="Terminal\nTaskfile.yml"];
    mpcli [label="Multipass CLI"];
    bin   [
      label=".bin/\nvault_2.2.0-beta1+ent (private beta)\nvault.hclic\n— gitignored, never committed",
      shape=note,
      style="filled",
      fillcolor="#f7f0fa",
      color="#7d5b92",
      fontsize=10
    ];

    term -> mpcli [label="task …"];
    bin -> mpcli [label="task provision\npushes both", style=dotted, color="#7d5b92", fontcolor="#5b3f6c"];
  }

  // ------------------------------------------------------------------- the VM
  subgraph cluster_vm {
    label="Ubuntu 24.04 arm64 VM  (tpm-lab)";
    labeljust="l";
    fontsize=12;
    fontcolor="#1a202c";
    margin=16;
    style="rounded,filled";
    fillcolor="#e8f0f8";
    color="#7f9bb8";
    penwidth=1.2;

    tpm [
      label="swtpm@device\nsoftware TPM 2.0\n~/lab/tpmstate/device/swtpm.sock",
      fillcolor="#dcedd9",
      color="#5f8a57"
    ];

    attacker [
      label="swtpm@attacker\n~/lab/tpmstate/attacker/swtpm.sock\ndifferent storage seed, different EK\n(Part 8 only)",
      style="rounded,filled,dashed",
      fillcolor="#f2f2f0",
      color="#6b6b64",
      fontcolor="#3d3d38"
    ];

    client [
      label="Device client\nvault tpm attest / vault login -method=tpm\nnode01.devices.lab.local",
      fillcolor="#fdf0da",
      color="#b5883f"
    ];

    // ------------------------------------------------------------ Vault itself
    subgraph cluster_vault {
      label="vault-dev  —  Vault Enterprise 2.2.0-beta1, https://127.0.0.1:8200  (dev, in-memory)";
      labeljust="l";
      fontsize=12;
      fontcolor="#1a202c";
      margin=16;
      style="rounded,filled";
      fillcolor="#f4eaf6";
      color="#9e7fae";
      penwidth=1.2;

      reg  [label="identity/tpm\nregistry of endorsement keys\ngroup: devices",         fillcolor="#ece0f2", color="#7d5b92"];
      tpma [label="tpm auth method\ninternal CA + role: devices\n(trusts the group)",     fillcolor="#ece0f2", color="#7d5b92"];
      kv   [label="KV v2\nsecret/devices/node01",                                      fillcolor="#ece0f2", color="#7d5b92"];
    }
  }

  // ---------------------------------------------------------------- host -> VM
  mpcli -> client [
    lhead=cluster_vm,
    # Trailing blank line lifts the text clear of the dashed spline, which
    # otherwise runs straight through it on this long horizontal edge.
    label="multipass transfer / exec\n ",
    style=dashed,
    color="#6b7280"
  ];

  // ----------------------------------------------------------------- lab flows
  client -> tpm    [label="EK, AK, app key:\nall created and used\ninside the TPM", color="#5f8a57", fontcolor="#3f5f39"];
  client -> reg    [label="1. orchestrator registers\nthe EK (scoped token)", color="#7d5b92", fontcolor="#5b3f6c"];
  client -> tpma   [label="2. attest (no token) →\ncertificate; 3. mTLS login", color="#b5883f", fontcolor="#7d5c22"];
  tpma   -> reg    [label="looks the EK up", style=dotted, constraint=false, color="#7d5b92", fontcolor="#5b3f6c"];
  tpma   -> client [label="4. token, policy device-read", color="#7d5b92", fontcolor="#5b3f6c"];
  client -> kv     [label="5. read (write denied)", color="#b5883f", fontcolor="#7d5c22"];

  client -> attacker [
    # constraint=false leaves this edge out of rank assignment, so the spline
    # runs straight through a plain centred label. Graphviz trims whitespace
    # padding, so the clearance has to be structural: an HTML label with an
    # empty right-hand cell shifts the text off the line.
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0" CELLSPACING="0"><TR>
             <TD ALIGN="RIGHT">Part 8.1: same blobs,<BR/>different TPM &#8594;<BR/>integrity check fails<BR/>Part 8.2: unregistered EK &#8594;<BR/>refused at attestation</TD>
             <TD WIDTH="24"></TD></TR></TABLE>>,
    style=dashed,
    color="#6b6b64",
    fontcolor="#3d3d38",
    constraint=false
  ];
}

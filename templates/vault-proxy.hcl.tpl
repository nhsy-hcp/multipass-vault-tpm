# Per-application Vault Agent API proxy configuration for the Part 11 demo.
#
# REFERENCE COPY. Templates live on the host and are never transferred into the
# VM, so the authoritative content is the heredoc in scripts/82_app_proxies.sh.
# Keep the two in sync.
#
# Rendered once per application to /etc/vault-proxy/${APP}.hcl, 0600, root-owned.
# ${APP} is payments or analytics; the role is fixed to ${APP}-app.

# Vault Agent API proxy for ${APP}. Generated by scripts/82_app_proxies.sh.
# The role is fixed here: the application cannot ask for a different one.

vault {
  address = "https://127.0.0.1:8200"
  ca_cert = "${TLS_DIR}/vault-ca.pem"
}

tpm_cert "${APP}" {
  role_name  = "${APP}-app"
  mount_path = "auth/${TPM_MOUNT}"

  tpm {
    device_path = "${TPM_SOCK}"
  }

  destination {
    path = "${TPM_DIR}/app-${APP}"
  }

  renew {
    min_validity_percentage = 50
  }
}

auto_auth {
  method {
    type       = "tpm"
    mount_path = "auth/${TPM_MOUNT}"

    # One attestation per EK every ten seconds: the second agent waits its turn.
    min_backoff = "10s"
    max_backoff = "2m"

    config = {
      tpm_cert = "${APP}"
    }
  }
}

api_proxy {
  use_auto_auth_token = "force"
}

listener "unix" {
  address      = "/run/vault-proxy/${APP}.sock"
  socket_mode  = "600"
  socket_user  = "${APP}"
  socket_group = "${APP}"
  tls_disable  = true
}

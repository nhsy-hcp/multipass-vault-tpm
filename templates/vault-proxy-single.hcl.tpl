# Vault Agent API proxy configuration for the Part 10 demo.
#
# REFERENCE COPY. Templates live on the host and are never transferred into the
# VM, so the authoritative content is the heredoc in scripts/81_proxy.sh.
# Keep the two in sync.
#
# Rendered to ${VM_DIR}/proxy/proxy.hcl, 0640, owned by the lab user. One workload
# (payments) reaches Vault at http://${LISTEN} and never holds a token.

# Vault Agent API proxy for one workload. Generated by scripts/81_proxy.sh.

vault {
  address = "https://127.0.0.1:8200"
  ca_cert = "${TLS_DIR}/vault-ca.pem"
}

tpm_cert "${APP}" {
  role_name  = "${ROLE}"
  mount_path = "auth/${TPM_MOUNT}"

  tpm {
    device_path = "${TPM_SOCK}"
  }

  destination {
    path = "${PROXY_STATE}"
  }

  renew {
    min_validity_percentage = 50
  }
}

auto_auth {
  method {
    type       = "tpm"
    mount_path = "auth/${TPM_MOUNT}"

    # Vault rate-limits attestation to one per EK every ten seconds, and Part 9
    # attested moments ago.
    min_backoff = "10s"
    max_backoff = "2m"

    config = {
      tpm_cert = "${APP}"
    }
  }
}

# Every request through the listener carries the agent's token, whatever the
# caller sent — including no token, and including root.
api_proxy {
  use_auto_auth_token = "force"
}

listener "tcp" {
  address     = "${LISTEN}"
  tls_disable = true
}

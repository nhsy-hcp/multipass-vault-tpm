# Vault Agent API proxy unit for the Part 10 demo.
#
# REFERENCE COPY. Templates live on the host and are never transferred into the
# VM, so the authoritative content is the heredoc in scripts/81_proxy.sh.
# Keep the two in sync.
#
# Installed as /etc/systemd/system/vault-proxy-single.service and left DISABLED,
# like vault-agent.service: dev-mode Vault forgets the mount on restart.

# Vault Agent API proxy (TPM auto-auth) for one workload.
# Generated by scripts/81_proxy.sh.
[Unit]
Description=Vault Agent API proxy on ${LISTEN} (TPM auto-auth, role ${ROLE})
Documentation=https://developer.hashicorp.com/vault/docs/agent-and-proxy/agent/apiproxy
After=network-online.target vault-dev.service swtpm@device.service
Wants=network-online.target
ConditionPathExists=${DEVICE_DIR}/tpm_id

[Service]
Type=simple
User=${VM_USER}
Group=${VM_USER}
WorkingDirectory=${PROXY_DIR}
Environment=VAULT_TOKEN=
ExecStart=/usr/bin/vault agent -config=${PROXY_HCL}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

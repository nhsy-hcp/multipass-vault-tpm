# Per-application Vault Agent API proxy unit for the Part 11 demo.
#
# REFERENCE COPY. Templates live on the host and are never transferred into the
# VM, so the authoritative content is the heredoc in scripts/82_app_proxies.sh.
# Keep the two in sync.
#
# Installed as /etc/systemd/system/vault-proxy@.service (vault-proxy@payments,
# vault-proxy@analytics) and left DISABLED. Runs as root on purpose: only root
# can hand the listener socket to the application's uid, and the applications
# must not be able to reach the TPM themselves.

# Vault Agent API proxy (TPM auto-auth) for one application, %i.
# Generated by scripts/82_app_proxies.sh.
[Unit]
Description=Vault Agent API proxy for %i (TPM auto-auth, role %i-app)
Documentation=https://developer.hashicorp.com/vault/docs/agent-and-proxy/agent/apiproxy
After=network-online.target vault-dev.service swtpm@device.service
Wants=network-online.target
ConditionPathExists=${DEVICE_DIR}/tpm_id

[Service]
Type=simple
Environment=VAULT_TOKEN=
ExecStart=/usr/bin/vault agent -config=/etc/vault-proxy/%i.hcl
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
